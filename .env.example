# Copy to .env for local development, and set the same values in your hosting
# provider's environment settings. Never commit a real .env file.

# --- Supabase (Project Settings → API) ---------------------------------------
# Public values: these are bundled into the browser build.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Server-side copies of the same public values.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SECRET: server only. Bypasses row-level security — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# --- Notification emails (optional) -----------------------------------------
# Account emails (sign-up, password reset) are sent by Supabase Auth.
# Order, lab and appointment notifications are only sent if these are set;
# without them they are skipped and patients see updates in the portal only.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@your-domain.com
EMAIL_FROM_NAME=Amino Flux Rx

# --- Scheduled reminders (optional) -----------------------------------------
# Shared secret for POST /api/public/hooks/notifications (header: x-cron-secret).
NOTIFICATION_CRON_SECRET=

# --- PayPal (optional; button is hidden when unset) --------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
